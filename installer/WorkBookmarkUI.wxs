<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <WixVariable Id="WixUIDialogBmp" Value="$(var.InstallerAssetsDirectory)\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.InstallerAssetsDirectory)\banner.bmp" />
    <!-- Reuse the supported WixUI dialogs, with a fixed per-user destination and no license/path steps. -->
    <UI Id="WorkBookmarkUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="맑은 고딕" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="맑은 고딕" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="맑은 고딕" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"
               Condition="NOT Installed OR PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg"
               Condition="Installed AND NOT PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <!-- ExitDialog runs only on success. Never launch during silent/basic UI, extraction, repair, or removal. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchWorkBookmarkAfterInstall" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND NOT REMOVE AND NOT REINSTALL AND NOT UPGRADINGPRODUCTCODE AND ACTION = &quot;INSTALL&quot; AND UILevel = 5" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </Fragment>
</Wix>
