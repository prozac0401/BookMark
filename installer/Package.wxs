<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="WorkBookmark" Manufacturer="WorkBookmark" Version="$(var.Version)"
           ProductCode="$(var.ProductCode)" UpgradeCode="BB5C5CA8-5BA0-4B01-875E-9E295690C711"
           Language="1033" Codepage="949" Scope="perUser" InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="WorkBookmark per-user Windows desktop installer" />
    <!-- Keep ProductLanguage and UpgradeCode compatible with the previously shipped MSI family. -->
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="더 최신 버전의 업무 책갈피가 이미 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/prozac0401/BookMark" />
    <Property Id="ARPPRODUCTICON" Value="WorkBookmarkIcon" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="SAVED_INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="ReadInstallFolder" Root="HKCU" Key="Software\WorkBookmark\Installer"
                      Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>
    <!-- Resolve the original location before costing, including silent repair/removal.
         Relocation of an installed product requires uninstall followed by a fresh install. -->
    <SetProperty Id="INSTALLFOLDER" Value="[SAVED_INSTALLFOLDER]" Before="CostInitialize"
                 Sequence="both" Condition="SAVED_INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="업무 책갈피 실행" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixUnelevatedShellExecTarget" Value="[#WorkBookmarkExecutable]" />
    <UIRef Id="WorkBookmarkUI" />
    <Property Id="STARTUP_PREFERENCE" Secure="yes">
      <RegistrySearch Id="ReadStartupPreference" Root="HKCU" Key="Software\WorkBookmark\Preferences"
                      Name="StartWithWindows" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR VersionNT64" Message="업무 책갈피는 64비트 Windows가 필요합니다." />
    <Icon Id="WorkBookmarkIcon" SourceFile="$(var.PublishDirectory)\WorkBookmark.exe" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="WorkBookmark">
          <Component Id="InstallFolderRegistration" Guid="D10F1804-C10D-481B-A5B0-F831A061C121" Bitness="always64">
            <RegistryValue Root="HKCU" Key="Software\WorkBookmark\Installer" Name="InstallFolder"
                           Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="WorkBookmarkMenu" Name="WorkBookmark">
        <Component Id="StartMenuShortcut" Guid="D6242BF4-80C4-4CAB-A0C7-2D6DD102D0B1" Bitness="always64">
          <Shortcut Id="LaunchWorkBookmark" Name="WorkBookmark" Target="[INSTALLFOLDER]WorkBookmark.exe"
                    WorkingDirectory="INSTALLFOLDER" Icon="WorkBookmarkIcon" />
          <RemoveFolder Id="RemoveWorkBookmarkMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\WorkBookmark\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="StartupFolder">
      <Component Id="StartupShortcut" Guid="08612B66-9AA7-47E0-9789-A3B9B3FF080D" Bitness="always64"
                 Condition="STARTUP_PREFERENCE &lt;&gt; &quot;#0&quot;">
        <Shortcut Id="StartWorkBookmarkAtLogon" Name="WorkBookmark" Target="[INSTALLFOLDER]WorkBookmark.exe"
                  Description="WorkBookmark per-user startup shortcut v1" WorkingDirectory="INSTALLFOLDER" Icon="WorkBookmarkIcon" />
        <RegistryValue Root="HKCU" Key="Software\WorkBookmark\Installer" Name="Startup" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="StartupCleanup" Guid="655DD4CB-202B-46AE-A69F-038530E7600D" Bitness="always64">
        <!-- The application can recreate this same owned shortcut after an install with startup disabled. -->
        <RemoveFile Id="RemoveOwnedStartupShortcut" Name="WorkBookmark.lnk" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\WorkBookmark\Installer" Name="StartupCleanup" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <CustomAction Id="StopWorkBookmark" FileRef="WorkBookmarkExecutable" ExeCommand="--installer-shutdown" Return="ignore" />
    <!-- Only the successful completion dialog can launch the app, in the interactive user's shell. -->
    <CustomAction Id="LaunchWorkBookmarkAfterInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixUnelevatedShellExec"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopWorkBookmark" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>
    <Feature Id="WorkBookmarkFeature" Title="WorkBookmark" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartupShortcut" />
      <ComponentRef Id="StartupCleanup" />
      <ComponentRef Id="InstallFolderRegistration" />
    </Feature>
  </Package>
</Wix>
