<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ko-kr" Codepage="949" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="WelcomeDlgTitle" Value="{\WixUI_Font_Bigger}업무 책갈피 설치" />
  <String Id="WelcomeDlgDescription" Value="문서와 웹페이지의 작업 위치를 저장하고 다시 여세요. 다음을 눌러 설치를 진행하세요." />
  <String Id="VerifyReadyDlgInstallText" Value="설치를 누르면 업무 책갈피 [ProductVersion]을 설치합니다. 이전 버전은 자동으로 업데이트되며, 기존 책갈피와 설정은 유지됩니다." />
  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}설치 마법사 완료" />
  <String Id="ExitDialogDescription" Value="요청한 작업을 완료했습니다. 마침을 눌러 설치 마법사를 종료하세요." />
  <String Id="MaintenanceWelcomeDlgDescription" Value="업무 책갈피가 이미 설치되어 있습니다. 다음을 눌러 복구하거나 제거할 수 있습니다." />
</WixLocalization>
